    "device.hostManaged": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app is controlling this mouse. Quit that app before adjusting it here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他软件正在接管这只鼠标的配置。退出那个软件后，才能在这里调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他軟體正在接管這隻滑鼠的設定。結束該軟體後，才能在這裡調整。"
          }
        }
      }
    },
    "device.noBattery": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery reading isn’t available yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没有读到电量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
