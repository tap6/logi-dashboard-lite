    "device.asleep": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is asleep. Move it, then refresh to read the battery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@在休眠。动一下，再点刷新就能读到电量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@正在休眠。動一下，再點重新整理就能讀到電量。"
          }
        }
      }
    },
