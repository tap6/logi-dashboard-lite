    "about.note1": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See battery, charging, and connection in the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏查看电量、充电和连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單列查看電量、充電和連線。"
          }
        }
      }
    },
    "about.note2": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See status in the dashboard, and change sensitivity with presets or a custom slider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板里看状态，用档位或自定义滑条改灵敏度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面板裡看狀態，用檔位或自訂滑桿改靈敏度。"
          }
        }
      }
    },
    "about.note3": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a low-battery notification, and optionally launch at login."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量偏低时通知，可选登录时启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電量偏低時通知，可選擇登入時啟動。"
          }
        }
      }
    },
