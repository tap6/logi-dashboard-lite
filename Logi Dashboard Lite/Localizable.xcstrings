    "alert.footer": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll be notified once when it drops to the threshold. It can alert again after charging starts, or after the battery rises above the threshold."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降到阈值时通知一次。开始充电，或电量回到阈值以上之后，才会再提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "降到閾值時通知一次。開始充電，或電量回到閾值以上之後，才會再提醒。"
          }
        }
      }
    },
