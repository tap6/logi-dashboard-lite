    "device.noOnboard": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no onboard profile. Battery and connection still show above."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只设备没有读到板载配置。电量和连接仍然显示在上面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部裝置沒有讀到內建設定。電量和連線仍然顯示在上方。"
          }
        }
      }
