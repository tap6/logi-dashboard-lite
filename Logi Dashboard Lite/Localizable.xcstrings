    "support.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardware reads are verified on PRO X Wireless over Lightspeed. Other models below are references, not a fully tested list. Battery reads require an accessible HID++ interface and battery feature. DPI and profiles require the corresponding device features."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前实机验证了 PRO X Wireless 的 Lightspeed 状态读取。下面其他型号仅供参考，并非全部实测清单。电量需要可访问的 HID++ 接口及电量功能；灵敏度和配置调整还需设备提供对应功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前實機驗證了 PRO X Wireless 的 Lightspeed 狀態讀取。下方其他型號僅供參考，並非全部實測清單。電量需要可存取的 HID++ 介面及電量功能；靈敏度與設定調整還需裝置提供對應功能。"
          }
        }
      }
    },
    "Supported wireless mice": {},
    "The dashboard switches profiles and sensitivity already saved on the mouse.": {},
    "The receiver is still connected, but this %@ is not.": {},
    "The slider changes the current sensitivity and leaves the presets alone. Turn it off to return to the selected preset.": {},
    "This device has no onboard profile.": {},
    "This device has no onboard profile. Battery and connection still show above.": {},
    "This usually takes a second or two.": {},
    "Unifying": {},
    "Unifying, Nano receivers, Lightspeed, Bolt, and Bluetooth mice that speak HID++ can report battery. Sensitivity can be changed only on mice with onboard presets. Other Logitech wireless mice on the same receiver can report battery too, as long as they use this protocol.": {},
    "Unknown": {},
    "Unofficial software. Not affiliated with Logitech.": {},
