    "custom.presetHelp": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presets match the DPI button on the mouse. Turn on the switch above for a custom value."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "档位和鼠标上的 DPI 键是同一套。自定义数值要打开上面的开关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔位和滑鼠上的 DPI 鍵是同一套。自訂數值要打開上面的開關。"
          }
        }
      }
    },
    "custom.sliderHelp": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The slider changes the current sensitivity and leaves the presets alone. Turn it off to return to the selected preset."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑条改的是当前灵敏度，不动档位。关掉后回到现在选中的档位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑桿改的是目前靈敏度，不會動到檔位。關掉後回到現在選取的檔位。"
          }
        }
      }
    },
